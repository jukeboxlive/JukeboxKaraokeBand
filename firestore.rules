rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Songs: public read, write allowed (admin seed + management)
    match /songs/{songId} {
      allow read: if true;
      allow write: if true;
    }
    // Stages: public read, write allowed (admin controls)
    match /stages/{stageId} {
      allow read: if true;
      allow write: if true;
    }
    // Applicants: public read + create with validation, update/delete for admin
    match /applicants/{applicantId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 50
                    && request.resource.data.surname is string
                    && request.resource.data.surname.size() > 0
                    && request.resource.data.surname.size() <= 50
                    && request.resource.data.status == "waiting"
                    && request.resource.data.songId is string
                    && request.resource.data.stageId is string;
      allow update, delete: if true;
    }
    // Votes: public read, create with validation, delete for cleanup
    match /votes/{voteId} {
      allow read: if true;
      allow create: if request.resource.data.score is int
                    && request.resource.data.score >= 1
                    && request.resource.data.score <= 10
                    && request.resource.data.applicantId is string
                    && request.resource.data.deviceId is string;
      allow update: if false;
      allow delete: if true;
    }
    // Settings: public read + write (admin controls phases)
    match /settings/{doc} {
      allow read: if true;
      allow write: if true;
    }
    // Song requests: public create with validation, public read, admin update/delete
    match /songRequests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 100
                    && request.resource.data.artist is string
                    && request.resource.data.artist.size() > 0
                    && request.resource.data.artist.size() <= 100;
      allow update, delete: if true;
    }
  }
}
